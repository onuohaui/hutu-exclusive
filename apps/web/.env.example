# Optional: paste the public Tally form URL here when the Help Me Choose form is ready.
VITE_TALLY_FORM_URL=

# Server-side subscription endpoint. Keep provider API credentials on that server, never in VITE_ variables.
VITE_ADVISORY_SUBSCRIBE_ENDPOINT=

# Server-side advisor enquiry endpoint. Keep provider API credentials on that server, never in VITE_ variables.
VITE_ADVISOR_ENQUIRY_ENDPOINT=

# Optional server-side proxy for Google Places review data. Keep the Google API key on the server.
VITE_GOOGLE_REVIEWS_ENDPOINT=
